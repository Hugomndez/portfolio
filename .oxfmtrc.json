{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": true,
  "arrowParens": "always",
  "printWidth": 120,
  "singleQuote": true,
  "bracketSameLine": true,
  "singleAttributePerLine": true,
  "quoteProps": "consistent",
  "ignorePatterns": ["pnpm-lock.yaml", "AGENT.md"]
}
