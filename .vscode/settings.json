{
  // ═══════════════════════════════════════════
  // ✍️  EDITOR — core editing behavior
  // ═══════════════════════════════════════════
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 100,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },

  // ═══════════════════════════════════════════
  // 🧑‍💻 LANGUAGES — TypeScript & ESLint
  // ═══════════════════════════════════════════
  //"js/ts.tsdk.path": "node_modules/typescript/lib", // workspace TS SDK (activate via "TypeScript: Select TypeScript Version")
  "eslint.workingDirectories": [{ "mode": "auto" }],

  // ═══════════════════════════════════════════
  // 📦 PROJECT TOOLING
  // ═══════════════════════════════════════════
  "npm.packageManager": "pnpm",

  // ═══════════════════════════════════════════
  // 🗂️  WORKBENCH — visibility & navigation
  // ═══════════════════════════════════════════
  "files.exclude": {
    "**/.next": true,
    "**/.next-docs": true,
    "**/.vercel": true,
    "**/tests/artifacts": true,
    "**/tests/reports": true,
    "**/next-env.d.ts": true
  },
  "search.exclude": {
    "**/pnpm-lock.yaml": true // committed, not gitignored — everything else is covered by .gitignore (search.useIgnoreFiles)
  },
  "workbench.editor.customLabels.patterns": {
    "**/app/**/page.tsx": "${dirname(1)}/${dirname} - page.tsx",
    "**/app/**/layout.tsx": "${dirname(1)}/${dirname} - layout.tsx",
    "**/app/**/loading.tsx": "${dirname(1)}/${dirname} - loading.tsx",
    "**/app/**/error.tsx": "${dirname(1)}/${dirname} - error.tsx",
    "**/app/**/not-found.tsx": "${dirname(1)}/${dirname} - not-found.tsx",
    "**/app/**/template.tsx": "${dirname(1)}/${dirname} - template.tsx",
    "**/app/**/default.tsx": "${dirname(1)}/${dirname} - default.tsx",
    "**/app/**/route.ts": "${dirname(1)}/${dirname} - route.ts"
  },

  // ═══════════════════════════════════════════
  // 🔌 INTEGRATIONS — external tooling
  // ═══════════════════════════════════════════
  "github-actions.workflows.pinned.workflows": [".github/workflows/playwright.yml"],
  "chat.mcp.serverSampling": {
    "portfolio/.vscode/mcp.json: next-devtools": {
      "allowedModels": ["copilot/gpt-5-mini", "copilot/gpt-5"]
    }
  },
  "js/ts.experimental.useTsgo": true
}
