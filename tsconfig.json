{
  "compilerOptions": {
    "target": "es2025",
    "lib": ["dom", "esnext"],
    "strict": true,
    "allowJs": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "incremental": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "paths": {
      "@/utils/*": ["./src/utils/*"],
      "@/services/*": ["./src/services/*"],
      "@/components/*": ["./src/app/_components/*"],
      "@/config/*": ["./src/app/_config/*"],
      "@/assets/*": ["./src/app/_assets/*"],
      "@/fonts": ["./src/app/_fonts"],
      "@/styles/*": ["./src/app/_styles/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
