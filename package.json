{
  "name": "portfolio",
  "version": "0.0.2",
  "private": true,
  "description": "My portfolio site build with NextJS",
  "homepage": "https://hugomendez.dev",
  "bugs": {
    "url": "https://github.com/Hugomndez/portfolio/issues"
  },
  "author": {
    "name": "Hugo Méndez",
    "url": "https://hugomendez.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hugomndez/portfolio"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "next experimental-analyze",
    "start": "next start",
    "check-types": "tsc --noEmit --checkers 4",
    "check-types:clean": "tsc --build --clean",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report tests/reports",
    "test:clean": "rm -rf tests/artifacts tests/reports",
    "lint": "oxlint ",
    "lint:fix": "oxlint --fix",
    "lint:rules": "oxlint --rules",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "postinstall": "husky"
  },
  "dependencies": {
    "@azure/msal-node": "7.0.1",
    "@hookform/resolvers": "5.9.1",
    "@marsidev/react-turnstile": "1.6.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@vercel/speed-insights": "2.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@unpic/pixels": "1.3.0",
    "@unpic/placeholder": "0.1.2",
    "blurhash": "2.0.5",
    "browserslist-config-baseline": "0.5.0",
    "dotenv": "18.0.7",
    "eslint-plugin-yml": "3.9.0",
    "husky": "9.1.7",
    "next-devtools-mcp": "0.4.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "schema-dts": "2.1.0",
    "typescript": "7.0.2"
  },
  "browserslist": [
    "extends browserslist-config-baseline"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x",
    "pnpm": "12.x",
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "browserslist-config-baseline": {
    "baselineYear": 2024
  }
}
