{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "react",
    "react-perf",
    "nextjs",
    "jsx-a11y"
  ],
  "jsPlugins": ["eslint-plugin-yml"],
  "categories": {
    "correctness": "error",
    "perf": "error",
    "style": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "env": {
    "builtin": true,
    "node": true,
    "browser": true
  },
  "settings": {
    "react": {
      "version": "19.3.0"
    }
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "public/**",
    "next-env.d.ts",
    "pnpm-lock.yaml",
    "tests/artifacts/**",
    "tests/reports/**",
    ".next-docs/**",
    "coverage/**"
  ],
  "rules": {
    // Baseline: oxlint's correctness/perf/style categories run at error (see "categories" above). //
    // Only deviations from oxlint's built-in defaults are listed below: disabled default-on      //
    // rules, error -> warn downgrades, off-by-default rules turned on, or custom options.        //
    // Grouped by plugin scope.                                                                   //

    // ESLint core: default-on rules turned off (too annoyingly strict) //
    "max-statements": "off",
    "no-duplicate-imports": "off",
    "no-magic-numbers": "off",
    "no-ternary": "off",
    "sort-imports": "off",
    "sort-keys": "off",
    // End of ESLint core: turned off //

    // ESLint core: off-by-default rules turned on //
    "no-array-constructor": "error",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    // End of ESLint core: turned on //

    // ESLint core: custom options on default-on rules //
    "capitalized-comments": ["error", "always"],
    "func-style": ["error", "declaration", { "allowArrowFunctions": true }],
    "id-length": ["error", { "min": 2, "checkGeneric": false }],
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "one-var": ["error", "never"],
    // End of ESLint core: custom options //

    // import: default-on rules turned off (too annoyingly strict) //
    "import/group-exports": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    // End of import: turned off //

    // jsx-a11y: custom options on default-on rules (alt-text also downgraded error -> warn) //
    "jsx-a11y/alt-text": [
      "warn",
      {
        "elements": ["img"],
        "img": ["Image"]
      }
    ],
    "jsx-a11y/control-has-associated-label": [
      2,
      {
        "labelAttributes": ["label"],
        "ignoreElements": ["audio", "canvas", "embed", "input", "textarea", "tr", "video"],
        "ignoreRoles": [
          "grid",
          "listbox",
          "menu",
          "menubar",
          "radiogroup",
          "row",
          "tablist",
          "toolbar",
          "tree",
          "treegrid"
        ],
        "depth": 3
      }
    ],
    "jsx-a11y/interactive-supports-focus": [
      "error",
      {
        "tabbable": ["button", "checkbox", "link", "searchbox", "spinbutton", "switch", "textbox"]
      }
    ],
    "jsx-a11y/no-interactive-element-to-noninteractive-role": [
      "error",
      {
        "tr": ["none", "presentation"],
        "canvas": ["img"]
      }
    ],
    "jsx-a11y/no-noninteractive-element-interactions": [
      "error",
      {
        "handlers": [
          "onClick",
          "onError",
          "onLoad",
          "onMouseDown",
          "onMouseUp",
          "onKeyPress",
          "onKeyDown",
          "onKeyUp"
        ],
        "alert": ["onKeyUp", "onKeyDown", "onKeyPress"],
        "body": ["onError", "onLoad"],
        "dialog": ["onKeyUp", "onKeyDown", "onKeyPress"],
        "iframe": ["onError", "onLoad"],
        "img": ["onError", "onLoad"]
      }
    ],
    "jsx-a11y/no-noninteractive-element-to-interactive-role": [
      "error",
      {
        "ul": ["listbox", "menu", "menubar", "radiogroup", "tablist", "tree", "treegrid"],
        "ol": ["listbox", "menu", "menubar", "radiogroup", "tablist", "tree", "treegrid"],
        "li": ["menuitem", "menuitemradio", "menuitemcheckbox", "option", "row", "tab", "treeitem"],
        "table": ["grid"],
        "td": ["gridcell"],
        "fieldset": ["radiogroup", "presentation"]
      }
    ],
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      {
        "tags": [],
        "roles": ["tabpanel"],
        "allowExpressionValues": true
      }
    ],
    "jsx-a11y/no-static-element-interactions": [
      "error",
      {
        "allowExpressionValues": true,
        "handlers": ["onClick", "onMouseDown", "onMouseUp", "onKeyPress", "onKeyDown", "onKeyUp"]
      }
    ],
    // End of jsx-a11y //

    // react: off-by-default rules turned on //
    "react/display-name": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/no-unescaped-entities": "error",
    "react/require-render-return": "error",
    "react/rules-of-hooks": "error",
    "react/unsupported-syntax": "warn",
    // End of react: turned on //

    // react: custom options on default-on rules //
    "react/function-component-definition": [
      "error",
      { "namedComponents": "arrow-function", "unnamedComponents": "function-expression" }
    ],
    "react/jsx-max-depth": ["error", { "max": 4 }],
    "react/jsx-props-no-spreading": ["error", { "html": "ignore" }],
    // End of react: custom options //

    // react-perf: error -> warn downgrade + custom options //
    "react-perf/jsx-no-new-function-as-prop": "warn",
    "react-perf/jsx-no-new-object-as-prop": [
      "error",
      {
        "nativeAllowList": "all"
      }
    ],
    // End of react-perf //

    // yml: custom rules for YAML files (via jsPlugin eslint-plugin-yml) //
    "yml/block-mapping-colon-indicator-newline": "error",
    "yml/block-mapping-question-indicator-newline": "error",
    "yml/block-mapping": "error",
    "yml/block-sequence-hyphen-indicator-newline": "error",
    "yml/block-sequence": "error",
    "yml/flow-mapping-curly-newline": "error",
    "yml/flow-mapping-curly-spacing": "error",
    "yml/flow-sequence-bracket-newline": "error",
    "yml/flow-sequence-bracket-spacing": "error",
    "yml/indent": "error",
    "yml/key-spacing": "error",
    "yml/no-empty-document": "error",
    "yml/no-empty-key": "error",
    "yml/no-empty-mapping-value": "error",
    "yml/no-empty-sequence-entry": "error",
    "yml/no-irregular-whitespace": "error",
    "yml/no-multiple-empty-lines": "error",
    "yml/no-tab-indent": "error",
    "yml/no-trailing-spaces": "error",
    "yml/no-trailing-zeros": "error",
    "yml/plain-scalar": "error",
    "yml/quotes": [
      "warn",
      {
        "prefer": "single",
        "avoidEscape": true
      }
    ],
    "yml/spaced-comment": "error",
    "yml/vue-custom-block/no-parsing-error": "error"
    // End of yml //
  },

  "overrides": [
    // TypeScript-only rules: scoped to TS files so plain JS/CJS scripts and configs //
    // never get TS semantics (e.g. no-require-imports on a .cjs script).           //
    {
      "files": ["**/*.{ts,mts,cts,tsx}"],
      "rules": {
        // typescript: off-by-default rules turned on at error //
        "typescript/ban-ts-comment": [
          "error",
          {
            "ts-expect-error": "allow-with-description",
            "ts-ignore": "allow-with-description",
            "ts-nocheck": false,
            "ts-check": false,
            "minimumDescriptionLength": 3
          }
        ],
        "typescript/no-empty-object-type": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-misused-promises": [
          "error",
          {
            "checksVoidReturn": {
              "attributes": false
            }
          }
        ],
        "typescript/no-namespace": "error",
        "typescript/no-require-imports": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/no-unnecessary-type-constraint": "error",
        "typescript/no-unsafe-enum-comparison": "error",
        "typescript/no-unsafe-function-type": "error",
        "typescript/only-throw-error": "error",
        "typescript/prefer-promise-reject-errors": "error",
        "typescript/require-await": "error",
        "typescript/restrict-plus-operands": "error",
        // End of typescript: error //

        // typescript: off-by-default rules turned on at warn //
        "typescript/no-unsafe-argument": "warn",
        "typescript/no-unsafe-assignment": "warn",
        "typescript/no-unsafe-call": "warn",
        "typescript/no-unsafe-member-access": "warn",
        "typescript/no-unsafe-return": "warn",
        // End of typescript: warn //

        // typescript: default error downgraded to warn //
        "typescript/consistent-type-imports": [
          "warn",
          {
            "prefer": "type-imports",
            "fixStyle": "separate-type-imports"
          }
        ],
        "typescript/consistent-type-definitions": ["warn", "type"]
        // End of typescript: downgraded //
      }
    }
  ]
}
